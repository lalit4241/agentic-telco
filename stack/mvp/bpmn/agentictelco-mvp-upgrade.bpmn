<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="Defs_MVP" targetNamespace="https://agentictelco.example/mvp/l5"
  exporter="AgenticTelco (hand-authored, adapted from broadband-upgrade-saga.bpmn)" exporterVersion="2.0">
  <bpmn:error id="Error_PolicyBlocked" name="Policy blocked (binding OPA deny)" errorCode="POLICY_BLOCKED" />
  <bpmn:error id="Error_Identity" name="Identity not certain" errorCode="IDENTITY_REVIEW" />
  <bpmn:process id="agentictelcoMvpUpgrade" name="L5 · Business broadband upgrade (MVP)" isExecutable="true" operaton:historyTimeToLive="P30D">
    <bpmn:documentation>AgenticTelco MVP, L5 Deterministic Execution. The agent may only START this process (via the intent service) and READ it.
Every system-of-record write happens here, after the binding policy check. No DMN: the rule lives once, in OPA. No step calls a model.
Business key = order external ID, so a rerun cannot double-write. Timers run on the demo clock (1 business day = 4 s).</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Upgrade proposed (Intent recorded)"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="T_Binding" name="Binding policy check (OPA) + identity check" operaton:type="external" operaton:topic="mvp-binding-check"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_Quote" name="Create quote [TMF648]" operaton:type="external" operaton:topic="mvp-quote"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_Order" name="Place upgrade order, action modify [TMF622]" operaton:type="external" operaton:topic="mvp-order"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_OssSubmit" name="Send to legacy OSS [TMF641]" operaton:type="external" operaton:topic="mvp-oss-submit"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_Batch" name="Wait for overnight OSS batch"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration>PT4S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T_OssRead" name="Read OSS batch result" operaton:type="external" operaton:topic="mvp-oss-read"><bpmn:incoming>F6</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Oss" name="Port reserved?"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Jeopardy" name="Raise jeopardy, revised date +2 days (intent at risk)" operaton:type="external" operaton:topic="mvp-jeopardy"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_Delay" name="Wait 2 days for a free port"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration>PT8S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T_Activate" name="Complete order [TMF622]" operaton:type="external" operaton:topic="mvp-activate"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_Asset" name="Asset change: 150 Obsolete, 900 Installed, Upgrade link [TMF637]" operaton:type="external" operaton:topic="mvp-asset-change"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_Fulfilled" name="Intent fulfilled [TMF921 report]" operaton:type="external" operaton:topic="mvp-intent-fulfilled"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="End_Live" name="Fibre 900 live"><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="Err_Policy" name="Policy blocked" attachedToRef="T_Binding"><bpmn:outgoing>F20</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_PolicyBlocked" /></bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Blocked" name="Stopped by policy (no writes)"><bpmn:incoming>F20</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="Err_Identity" name="Identity not certain" attachedToRef="T_Binding"><bpmn:outgoing>F21</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_Identity" /></bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Review" name="Raised for human review"><bpmn:incoming>F21</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Binding" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Binding" targetRef="T_Quote" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_Quote" targetRef="T_Order" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_Order" targetRef="T_OssSubmit" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_OssSubmit" targetRef="Timer_Batch" />
    <bpmn:sequenceFlow id="F6" sourceRef="Timer_Batch" targetRef="T_OssRead" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_OssRead" targetRef="Gw_Oss" />
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="Gw_Oss" targetRef="T_Activate"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${ossState == 'completed'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" name="no free port" sourceRef="Gw_Oss" targetRef="T_Jeopardy"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${ossState != 'completed'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="T_Jeopardy" targetRef="Timer_Delay" />
    <bpmn:sequenceFlow id="F12" sourceRef="Timer_Delay" targetRef="T_OssRead" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_Activate" targetRef="T_Asset" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Asset" targetRef="T_Fulfilled" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_Fulfilled" targetRef="End_Live" />
    <bpmn:sequenceFlow id="F20" sourceRef="Err_Policy" targetRef="End_Blocked" />
    <bpmn:sequenceFlow id="F21" sourceRef="Err_Identity" targetRef="End_Review" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="agentictelcoMvpUpgrade">
      <bpmndi:BPMNShape id="S_Start" bpmnElement="Start"><dc:Bounds x="20" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Binding" bpmnElement="T_Binding"><dc:Bounds x="86" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Quote" bpmnElement="T_Quote"><dc:Bounds x="226" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Order" bpmnElement="T_Order"><dc:Bounds x="366" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_OssSubmit" bpmnElement="T_OssSubmit"><dc:Bounds x="506" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TimerBatch" bpmnElement="Timer_Batch"><dc:Bounds x="646" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_OssRead" bpmnElement="T_OssRead"><dc:Bounds x="712" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Gw" bpmnElement="Gw_Oss" isMarkerVisible="true"><dc:Bounds x="852" y="75" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Jeopardy" bpmnElement="T_Jeopardy"><dc:Bounds x="822" y="190" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TimerDelay" bpmnElement="Timer_Delay"><dc:Bounds x="749" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Activate" bpmnElement="T_Activate"><dc:Bounds x="932" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Asset" bpmnElement="T_Asset"><dc:Bounds x="1072" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Fulfilled" bpmnElement="T_Fulfilled"><dc:Bounds x="1212" y="60" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End" bpmnElement="End_Live"><dc:Bounds x="1352" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_ErrPol" bpmnElement="Err_Policy"><dc:Bounds x="106" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndBlocked" bpmnElement="End_Blocked"><dc:Bounds x="106" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_ErrId" bpmnElement="Err_Identity"><dc:Bounds x="152" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndReview" bpmnElement="End_Review"><dc:Bounds x="212" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E1" bpmnElement="F1"><di:waypoint x="56" y="100" /><di:waypoint x="86" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="F2"><di:waypoint x="196" y="100" /><di:waypoint x="226" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="F3"><di:waypoint x="336" y="100" /><di:waypoint x="366" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="F4"><di:waypoint x="476" y="100" /><di:waypoint x="506" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="F5"><di:waypoint x="616" y="100" /><di:waypoint x="646" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="F6"><di:waypoint x="682" y="100" /><di:waypoint x="712" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="F7"><di:waypoint x="822" y="100" /><di:waypoint x="852" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E8" bpmnElement="F8"><di:waypoint x="902" y="100" /><di:waypoint x="932" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E10" bpmnElement="F10"><di:waypoint x="877" y="125" /><di:waypoint x="877" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E11" bpmnElement="F11"><di:waypoint x="822" y="230" /><di:waypoint x="785" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E12" bpmnElement="F12"><di:waypoint x="767" y="212" /><di:waypoint x="767" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E9" bpmnElement="F9"><di:waypoint x="1042" y="100" /><di:waypoint x="1072" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E13" bpmnElement="F13"><di:waypoint x="1182" y="100" /><di:waypoint x="1212" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E14" bpmnElement="F14"><di:waypoint x="1322" y="100" /><di:waypoint x="1352" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E20" bpmnElement="F20"><di:waypoint x="124" y="158" /><di:waypoint x="124" y="212" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E21" bpmnElement="F21"><di:waypoint x="170" y="158" /><di:waypoint x="170" y="230" /><di:waypoint x="212" y="230" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
